{
  "name": "warbound",
  "private": true,
  "version": "2.6.0",
  "description": "WARBOUND — The Fracture Chronicles. FPS 3D / Action RPG militaire dark fantasy.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run-all.mjs",
    "test:server": "cd server && node test/lobby.test.mjs && node test/accounts.test.mjs",
    "build:online-test": "VITE_LOBBY_URL=http://localhost:8787 vite build --outDir dist-test",
    "test:online": "node tests/online.mjs && node tests/shop.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.170.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "5.6",
    "vite": "5.4"
  }
}
